# =============================================================================
# 应用环境变量配置
# 复制此文件为 .env 并修改配置
# =============================================================================

# Docker 镜像配置
REGISTRY=ghcr.io
IMAGE_NAME=user-management-api
TAG=latest

# 应用端口配置
APP_PORT=8000

# 数据库配置
# SQLite 配置（默认）
DATABASE_URL=sqlite:///./data/user_management.db

# PostgreSQL 配置（可选，使用 docker-compose --profile postgres up）
# DATABASE_URL=postgresql://postgres:your_password@db:5432/usermanagement
POSTGRES_DB=usermanagement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# JWT 配置
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用配置
APP_NAME=User Management API
DEBUG=false

# Nginx 配置（可选，使用 docker-compose --profile nginx up）
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# 监控配置（可选，使用 docker-compose --profile monitoring up）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# 告警配置
ALERT_WEBHOOK_URL=

# GitHub Container Registry 登录配置（用于服务器拉取镜像）
GHCR_USERNAME=your_github_username
GHCR_TOKEN=your_github_personal_access_token
